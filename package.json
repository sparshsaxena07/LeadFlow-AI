{
  "name": "groweasy-ai-importer",
  "version": "1.0.0",
  "private": true,
  "description": "GrowEasy AI CSV Importer Monorepo",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev:frontend": "npm run dev --workspace=frontend",
    "dev:backend": "npm run dev --workspace=backend",
    "dev": "npm run dev --workspaces --parallel",
    "build:frontend": "npm run build --workspace=frontend",
    "build:backend": "npm run build --workspace=backend",
    "build": "npm run build --workspaces",
    "lint:frontend": "npm run lint --workspace=frontend",
    "lint:backend": "npm run lint --workspace=backend",
    "lint": "npm run lint --workspaces",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "test:datasets": "npm exec -w backend -- tsx ../tests/backend/runner.ts"
  }
}

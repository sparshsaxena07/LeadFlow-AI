{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "lib": ["ES2022", "DOM"],
    "types": ["node"],
    "typeRoots": [
      "../node_modules/@types",
      "../backend/node_modules/@types"
    ]
  },
  "include": ["**/*.ts"]
}
